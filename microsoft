<#
.SYNOPSIS
    Loader optimizado PLAYSTEAM — aparición instantánea + descarga paralela
    EJECUTAR CON: powershell.exe -STA -NoProfile -ExecutionPolicy Bypass -File loader.ps1
#>

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# ─── 1. Cargar WPF desde el GAC (más rápido que LoadWithPartialName) ───────
Add-Type -AssemblyName PresentationFramework
Add-Type -AssemblyName WindowsBase
Add-Type -AssemblyName PresentationCore

# ─── 2. Definir el XAML de la ventana ──────────────────────────────────────
$xaml = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="500" Width="800"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="Spin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Ring"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="Core"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1" Duration="0:0:1" AutoReverse="True" />
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Spin}" />
        </EventTrigger>
    </Window.Triggers>
    <Border Background="Black" CornerRadius="10">
        <Grid>
            <Ellipse x:Name="Ring" Width="90" Height="90"
                     Stroke="#ff4500" StrokeThickness="4"
                     StrokeDashArray="3 1" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="0" /></Ellipse.RenderTransform>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#ff0000" BlurRadius="15" ShadowDepth="0" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="Core" Width="40" Height="40" Fill="#ffaa00">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#ffaa00" BlurRadius="20" ShadowDepth="0" />
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="P R E P A R I N G . . ."
                       Foreground="#ffaa00" FontSize="18" FontWeight="ExtraBold"
                       Margin="0,150,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#ff4500" BlurRadius="10" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</Window>
"@

# ─── 3. Crear la ventana directamente en este hilo (ya es STA) ─────────────
$reader = New-Object System.Xml.XmlNodeReader ([xml]$xaml)
$window = [System.Windows.Markup.XamlReader]::Load($reader)

# ─── 4. Iniciar la descarga en PARALELO antes de mostrar la ventana ─────────
$url  = 'https://github.com/Rober324/PLAYSTEAM_AUTOLOGIN/releases/latest/download/PLAYSTEAM_NATIVO.exe'
$dest = "$env:temp\PLAYSTEAM_NATIVO.exe"

$job = Start-Job -ScriptBlock {
    param($u, $d)
    (New-Object Net.WebClient).DownloadFile($u, $d)
} -ArgumentList $url, $dest

# ─── 5. Mostrar ventana; cuando la descarga termine, cerrarla ───────────────
# Usamos un DispatcherTimer para chequear el job sin bloquear la UI
$timer = New-Object System.Windows.Threading.DispatcherTimer
$timer.Interval = [TimeSpan]::FromMilliseconds(200)

$timer.Add_Tick({
    if ($job.State -ne 'Running') {
        $timer.Stop()
        $window.Close()
    }
})

$window.Add_Loaded({ $timer.Start() })
$window.ShowDialog() | Out-Null   # Bloquea este hilo hasta que la ventana se cierre

# ─── 6. Limpiar el job y lanzar el EXE descargado como Admin ────────────────
Receive-Job $job -Wait | Out-Null
Remove-Job $job

if (Test-Path $dest) {
    Start-Process $dest -Verb RunAs
}
exit
